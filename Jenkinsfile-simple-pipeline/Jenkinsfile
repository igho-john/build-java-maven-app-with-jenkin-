#!/usr/bin/env groovy
@Library('jenkins-shared-library') _

pipeline {
    agent any
    tools {
        maven 'maven-3.9.16'
    }
    stages {
        stage("build jar") {
            steps {
                buildJar()
            }
        }
        stage("build image") {
            steps {
                buildDockerImage("ighojohn/demo-app:jma-2.0")
            }
        }
        stage("docker login") {
            steps {
                dockerLogin()
            }
        }
        stage("docker push") {
            steps {
                dockerPush("ighojohn/demo-app:jma-2.0")
            }
        }
        stage("deploy") {
            steps {
                echo "deploy stage placeholder"
            }
        }
    }
}
