#!/usr/bin/env groovy
library identifier: 'jenkins-shared-library@main', retriever: modernSCM(
    [$class: 'GitSCMSource',
     remote: 'https://github.com/igho-john/jenkins-shared-library.git',
     credentialsId: 'github-credentials']
)

pipeline {
    agent any
    tools {
        maven 'maven-3.9.16'
    }
    stages {
        stage("build jar") {
            steps {
                buildJar()
            }
        }
        stage("build image") {
            steps {
                buildImage("ighojohn/demo-app:jma-2.0")
            }
        }
        stage("docker login") {
            steps {
                dockerlogin()
            }
        }
        stage("docker push") {
            steps {
                dockerPush("ighojohn/demo-app:jma-2.0")
            }
        }
        stage("deploy") {
            steps {
                echo "deploy stage placeholder"
            }
        }
    }
}
