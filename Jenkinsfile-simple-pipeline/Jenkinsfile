pipeline {
    agent any
    tools {
        maven 'maven-3.9.16'
    }
    environment {
        IMAGE_NAME = "ighojohn/demo-app:jma-2.3"
    }
    stages {
        stage("build jar") {
            steps {
                buildJar()
            }
        }
        stage("build image") {
            steps {
                buildImage("${IMAGE_NAME}")
            }
        }
        stage("docker login") {
            steps {
                dockerlogin()
            }
        }
        stage("docker push") {
            steps {
                dockerPush("${IMAGE_NAME}")
            }
        }
        stage("deploy") {
            steps {
                echo "deploy stage placeholder"
            }
        }
    }
}
